# ==============================================================================
# VPS BACKUP MANAGER - CONFIGURATION TEMPLATE
# ==============================================================================
# Recommended permissions:
#   chmod 600 .env
#   chmod +x run_backup.sh
# ==============================================================================

# ==========================================
# 1. GENERAL LOGGING, ROTATION & HTML STATUS
# ==========================================
# Absolute or relative path to the persistent log file
BACKUP_LOG_FILE="/var/log/web_backup_manager/backup.log"

# Max log file size in MB before automatic rotation (default: 10MB)
BACKUP_LOG_MAX_MB=10

# Public read-only HTML dashboard file location (for Caddy/Nginx file server)
BACKUP_HTML_FILE="/var/www/backup_dashboard/index.html"

# Concurrency lock file (optional, defaults to /tmp/backup-manager.lock)
# LOCK_FILE="/tmp/backup-manager.lock"

# ==========================================
# 2. TELEGRAM BOT NOTIFICATIONS
# ==========================================
# Create a bot via Telegram @BotFather -> /newbot -> copy HTTP API token
# Obtain your target chat_id via @userinfobot or @myidbot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Automatically attach and send the complete .log file to Telegram on completion
TELEGRAM_SEND_LOG_DOCUMENT=true

# ==============================================================================
# 3. SITE DEFINITIONS (STANDARDIZED MODULAR STRUCTURE PER SITE)
# ==============================================================================
# Each site section features three optional plug-and-play components:
#   1. PostgreSQL Database  (SITE<N>_DB_ENABLE=true/false)
#   2. Cloudflare R2 / S3   (SITE<N>_R2_ENABLE=true/false)
#   3. Local Folder / CDN   (SITE<N>_FOLDER_ENABLE=true/false)

# ------------------------------------------------------------------------------
# SITE 1: PRODUCTION WEB APP (POSTGRESQL + CLOUDFLARE R2 / S3 BUCKET)
# ------------------------------------------------------------------------------
SITE1_ENABLE=true
SITE1_NAME="production_app"

# Dedicated Remotes (configured in `rclone config`)
SITE1_REMOTE_GDRIVE="prod_gdrive"
SITE1_REMOTE_NEXTCLOUD="nextcloud"
SITE1_REMOTE_R2="prod_r2"

# Component 1: PostgreSQL Database
SITE1_DB_ENABLE=true
SITE1_DB_URL="postgres://prod_user:prod_password@127.0.0.1:5432/production_db"
SITE1_DB_LOCAL_DIR="/var/backups/dumps/production_app"
SITE1_DB_LOCAL_RETENTION_DAYS=7
SITE1_DB_REMOTE_RETENTION_DAYS=90
# SITE1_DB_REMOTE_RETENTION_DAYS_GDRIVE=90
# SITE1_DB_REMOTE_RETENTION_DAYS_NEXTCLOUD=30
SITE1_DB_PATH_GDRIVE="backups/production/database"
SITE1_DB_PATH_NEXTCLOUD="backups/production/database"

# Component 2: Cloudflare R2 / S3 Media Bucket Sync
SITE1_R2_ENABLE=true
SITE1_R2_BUCKET="production-media-bucket"
SITE1_R2_PATH_GDRIVE="backups/production/r2_media"
# SITE1_R2_PATH_NEXTCLOUD="backups/production/r2_media"
SITE1_R2_TRASH_PATH_GDRIVE="backups/production/r2_trash"
# SITE1_R2_TRASH_PATH_NEXTCLOUD="backups/production/r2_trash"
SITE1_R2_TRASH_RETENTION_DAYS=60

# Component 3: Local Folder / Assets Sync (Disabled for Site 1)
SITE1_FOLDER_ENABLE=false

# Notifications
SITE1_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
# SITE1_TELEGRAM_BOT_TOKEN=""
# SITE1_TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# SITE 2: STAGING ENVIRONMENT (LIGHTWEIGHT RETENTION)
# ------------------------------------------------------------------------------
SITE2_ENABLE=false
SITE2_NAME="staging_app"

# Dedicated Remotes
SITE2_REMOTE_GDRIVE="staging_gdrive"
SITE2_REMOTE_NEXTCLOUD="nextcloud"
SITE2_REMOTE_R2="staging_r2"

# Component 1: PostgreSQL Database
SITE2_DB_ENABLE=true
SITE2_DB_URL="postgres://dev_user:dev_password@127.0.0.1:5433/staging_db"
SITE2_DB_LOCAL_DIR="/var/backups/dumps/staging_app"
SITE2_DB_LOCAL_RETENTION_DAYS=3
SITE2_DB_REMOTE_RETENTION_DAYS=30
# SITE2_DB_REMOTE_RETENTION_DAYS_GDRIVE=30
# SITE2_DB_REMOTE_RETENTION_DAYS_NEXTCLOUD=14
SITE2_DB_PATH_GDRIVE="backups/staging/database"
SITE2_DB_PATH_NEXTCLOUD="backups/staging/database"

# Component 2: Cloudflare R2 / S3 Media Bucket Sync
SITE2_R2_ENABLE=false
SITE2_R2_BUCKET="staging-media-bucket"
SITE2_R2_PATH_GDRIVE="backups/staging/r2_media"
# SITE2_R2_PATH_NEXTCLOUD="backups/staging/r2_media"
SITE2_R2_TRASH_PATH_GDRIVE="backups/staging/r2_trash"
# SITE2_R2_TRASH_PATH_NEXTCLOUD="backups/staging/r2_trash"
SITE2_R2_TRASH_RETENTION_DAYS=30

# Component 3: Local Folder / Assets Sync (Disabled for Site 2)
SITE2_FOLDER_ENABLE=false

# Notifications
SITE2_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
# SITE2_TELEGRAM_BOT_TOKEN=""
# SITE2_TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# SITE 3: CMS / WORDPRESS (DATABASE + LOCAL ASSETS FOLDER SYNC)
# ------------------------------------------------------------------------------
SITE3_ENABLE=true
SITE3_NAME="cms_portal"

# Dedicated Remotes
SITE3_REMOTE_GDRIVE="company_gdrive"
SITE3_REMOTE_NEXTCLOUD="nextcloud"

# Component 1: PostgreSQL Database
SITE3_DB_ENABLE=true
SITE3_DB_URL="postgres://cms_user:cms_password@127.0.0.1:5432/cms_db"
SITE3_DB_LOCAL_DIR="/var/backups/dumps/cms_portal"
SITE3_DB_LOCAL_RETENTION_DAYS=7
SITE3_DB_REMOTE_RETENTION_DAYS=90
# SITE3_DB_REMOTE_RETENTION_DAYS_GDRIVE=90
# SITE3_DB_REMOTE_RETENTION_DAYS_NEXTCLOUD=30
SITE3_DB_PATH_GDRIVE="backups/cms_portal/database"
SITE3_DB_PATH_NEXTCLOUD="backups/cms_portal/database"

# Component 2: Cloudflare R2 / S3 (Disabled for Site 3)
SITE3_R2_ENABLE=false

# Component 3: Local Folder / Uploads Backup
SITE3_FOLDER_ENABLE=true
SITE3_FOLDER_SRC="/var/www/cms/public/uploads"
SITE3_FOLDER_PATH_GDRIVE="backups/cms_portal/uploads"
SITE3_FOLDER_PATH_NEXTCLOUD="backups/cms_portal/uploads"
SITE3_FOLDER_MODE="sync" # "sync" (incremental mirror) or "archive" (tar.gz/zip)
# Optional versioned trash folder (if omitted, direct mirror sync is performed)
SITE3_FOLDER_TRASH_PATH_GDRIVE="backups/cms_portal/uploads_trash"
SITE3_FOLDER_TRASH_PATH_NEXTCLOUD="backups/cms_portal/uploads_trash"
SITE3_FOLDER_TRASH_RETENTION_DAYS=60

# Notifications
SITE3_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
# SITE3_TELEGRAM_BOT_TOKEN=""
# SITE3_TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# SITE 4: RAW DATA DIRECTORY ARCHIVE (NO DATABASE)
# ------------------------------------------------------------------------------
SITE4_ENABLE=true
SITE4_NAME="data_archive"

# Dedicated Remotes
SITE4_REMOTE_NEXTCLOUD="nextcloud"
SITE4_REMOTE_GDRIVE="company_gdrive"

# Component 1: PostgreSQL Database (Disabled for Site 4)
SITE4_DB_ENABLE=false

# Component 2: Cloudflare R2 / S3 (Disabled for Site 4)
SITE4_R2_ENABLE=false

# Component 3: Local Data Folder Backup (Archive mode)
SITE4_FOLDER_ENABLE=true
SITE4_FOLDER_SRC="/opt/services/data"
SITE4_FOLDER_PATH_NEXTCLOUD="backups/data_archive/files"
SITE4_FOLDER_PATH_GDRIVE="backups/data_archive/files"
SITE4_FOLDER_MODE="archive"
SITE4_FOLDER_ARCHIVE_FORMAT="tar.gz"  # "tar.gz" or "zip"
SITE4_FOLDER_ARCHIVE_LOCAL_DIR="/var/backups/dumps/data_archive"
SITE4_FOLDER_ARCHIVE_RETENTION_DAYS=30

# Notifications
SITE4_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
# SITE4_TELEGRAM_BOT_TOKEN=""
# SITE4_TELEGRAM_CHAT_ID=""
